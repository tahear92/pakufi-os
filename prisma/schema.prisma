generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AgentDefinition {
  id              String     @id @default(cuid())
  name            String     @unique
  department      String
  role            String
  systemPrompt    String
  toolPermissions Json
  deskPosition    Json?
  createdAt       DateTime   @default(now()) @db.Timestamptz(6)
  runs            AgentRun[]
}

model AgentRun {
  id          String          @id @default(cuid())
  agentId     String
  missionText String
  status      RunStatus       @default(READY)
  costUsd     Decimal?        @db.Decimal(10, 4)
  startedAt   DateTime        @default(now()) @db.Timestamptz(6)
  finishedAt  DateTime?       @db.Timestamptz(6)
  actions     AgentAction[]
  agent       AgentDefinition @relation(fields: [agentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvals   Approval[]
}

model AgentAction {
  id        String   @id @default(cuid())
  runId     String
  stepIndex Int
  toolUsed  String
  input     Json
  output    Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Approval {
  id          String         @id @default(cuid())
  runId       String
  type        String
  payload     Json
  status      ApprovalStatus @default(PENDING)
  requestedAt DateTime       @default(now()) @db.Timestamptz(6)
  resolvedAt  DateTime?      @db.Timestamptz(6)
  run         AgentRun       @relation(fields: [runId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Automation {
  id        String    @id @default(cuid())
  name      String
  schedule  String
  lastRunAt DateTime? @db.Timestamptz(6)
  nextRunAt DateTime? @db.Timestamptz(6)
}

model KnowledgeSource {
  id         String @id @default(cuid())
  title      String
  type       String
  location   String
  department String
}

model IntegrationConnection {
  id         String    @id @default(cuid())
  provider   String
  status     String
  lastSyncAt DateTime? @db.Timestamptz(6)
}

enum RunStatus {
  BACKLOG
  READY
  IN_PROGRESS
  WAITING_FOR_APPROVAL
  BLOCKED
  COMPLETED
  FAILED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  EDITED
  REJECTED
}
