# --- Set these on Vercel (or wherever the Next.js app actually runs) ---

# Server-side only, never shipped to the browser.
ANTHROPIC_API_KEY=

# Same key sync.py already uses -- Apollo's REST API (static key), not the
# OAuth-only MCP connector. See lib/integrations/apollo.ts for why.
APOLLO_API_KEY=

# Same key sync.py already uses -- Notion's internal integration token,
# not the OAuth-only MCP connector. See lib/integrations/notion.ts for why.
NOTION_API_KEY=

# postgresql://... -- from Neon, Supabase, Prisma Postgres, or any managed
# Postgres. Prisma 7 (pinned in package.json) expects the classic
# postgresql:// connection string here.
DATABASE_URL=

# Make this up yourself -- protects the cron endpoint from being called by
# anyone who finds the URL. Must match the GitHub Secret of the same name.
PAKUFI_OS_CRON_SECRET=

# --- Set these as GitHub Secrets (for .github/workflows/sales-morning-run.yml) ---

# The deployed app's URL, e.g. https://pakufi-os.vercel.app
# PAKUFI_OS_URL=

# Same value as above, just also needed here so the workflow can
# authenticate its request.
# PAKUFI_OS_CRON_SECRET=
